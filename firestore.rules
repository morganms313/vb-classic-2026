rules_version = '2';

// Anyone can read. Signed-in users can write scores and seeds, in a valid shape:
//   - Google or Apple accounts, or
//   - guests (Firebase anonymous sign-in), whose name must end in " (guest)".
// To turn guests off, remove 'anonymous' from the provider list below.
// To restrict editing to named scorekeepers later, change isEditor() to:
//   request.auth != null && request.auth.token.email in ['you@gmail.com', 'keeper@gmail.com']
service cloud.firestore {
  match /databases/{database}/documents {

    function provider() {
      return request.auth.token.firebase.sign_in_provider;
    }

    function isEditor() {
      return request.auth != null
        && (provider() == 'anonymous'
          || provider() == 'apple.com'
          || (provider() == 'google.com' && request.auth.token.email_verified == true));
    }

    function validScore(n) {
      return n is int && n >= 0 && n <= 60;
    }

    function validSet(s) {
      return s is map && s.keys().hasOnly(['a', 'b']) && validScore(s.a) && validScore(s.b) && s.a != s.b;
    }

    function validStamp(d) {
      return d.by is string && d.by.size() <= 80
        && (provider() != 'anonymous' || d.by.matches('.+ [(]guest[)]$'))
        && d.uid == request.auth.uid
        && d.updatedAt == request.time;
    }

    match /scores/{matchId} {
      allow read: if true;
      allow delete: if isEditor() && matchId.matches('^([A-F][1-6]|[GP]([1-9]|1[0-6]))$');
      allow create, update: if isEditor()
        && matchId.matches('^([A-F][1-6]|[GP]([1-9]|1[0-6]))$')
        && request.resource.data.keys().hasOnly(['sets', 'by', 'uid', 'updatedAt'])
        && request.resource.data.sets is list
        && request.resource.data.sets.size() >= 1
        && request.resource.data.sets.size() <= 3
        && validSet(request.resource.data.sets[0])
        && (request.resource.data.sets.size() < 2 || validSet(request.resource.data.sets[1]))
        && (request.resource.data.sets.size() < 3 || validSet(request.resource.data.sets[2]))
        && validStamp(request.resource.data);
    }

    match /seeds/{division} {
      allow read: if true;
      allow delete: if isEditor() && division in ['gold', 'purple'];
      allow create, update: if isEditor()
        && division in ['gold', 'purple']
        && request.resource.data.keys().hasOnly(['order', 'by', 'uid', 'updatedAt'])
        && request.resource.data.order is list
        && request.resource.data.order.size() == 12
        && validStamp(request.resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
